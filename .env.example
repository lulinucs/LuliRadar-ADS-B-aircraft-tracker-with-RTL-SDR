# Copie este arquivo para ".env" (na raiz do projeto) e preencha os valores.
# Linhas começando com # são comentários. Não são necessárias aspas.

# ---------------------------------------------------------------------------
# Posição do receptor - OBRIGATÓRIO para calcular distância das aeronaves e
# posicionar o mapa corretamente. Não inventamos esse valor: pegue no GPS do
# celular, no Google Maps (clique com o botão direito no seu ponto exato) ou
# em serviços como https://www.gps-coordinates.net/
# ---------------------------------------------------------------------------
RECEIVER_LAT=
RECEIVER_LON=
RECEIVER_LABEL=Minha estação

# ---------------------------------------------------------------------------
# Servidor web
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# dump1090-mutability (modo ADS-B)
# ---------------------------------------------------------------------------
DUMP1090_BIN=dump1090-mutability
# "auto" (equivale a --gain -10), "max" (ganho máximo, omite --gain) ou um
# valor numérico em dB (ex.: 40.2)
DUMP1090_GAIN=auto
DUMP1090_MAX_RANGE_NM=300
# Argumentos extras passados direto pra linha de comando do dump1090-mutability
DUMP1090_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# rtl_fm / rádio aeronáutico
# ---------------------------------------------------------------------------
RTL_FM_BIN=rtl_fm
APLAY_BIN=aplay
RADIO_SAMPLE_RATE=48000
RADIO_DEFAULT_GAIN=auto
RADIO_DEFAULT_SQUELCH_DBFS=-35
RADIO_DEFAULT_SILENCE_TIMEOUT=2.0
RADIO_DEFAULT_PREBUFFER_SEC=1.5
RADIO_MIN_RECORDING_SEC=0.6

# ---------------------------------------------------------------------------
# ADS-B: sessões e resolução de trajetória
# ---------------------------------------------------------------------------
# Segundos sem notícia de uma aeronave para considerar que ela "sumiu" e a
# próxima detecção vira uma nova sessão de voo
ADSB_SESSION_GAP_SECONDS=300
# Intervalo mínimo (s) entre posições gravadas de uma mesma aeronave
ADSB_POSITION_MIN_INTERVAL_SEC=3
# ...ou distância mínima (m) percorrida para forçar gravação antes do intervalo
ADSB_POSITION_MIN_DISTANCE_M=50
ADSB_SUMMARY_INTERVAL_SEC=10
# Segundos sem mensagem para uma aeronave sumir da lista "ao vivo"
ADSB_STALE_SECONDS=60

# ---------------------------------------------------------------------------
# SDRManager: confirmação de inicialização ao trocar de modo
# ---------------------------------------------------------------------------
# Tempo (s) que o SDRManager aguarda após lançar dump1090/rtl_fm para
# confirmar que o processo não morreu de imediato (ex.: "device busy") antes
# de declarar o modo como realmente ativo. Cada troca de modo fica mais lenta
# em exatamente esse tanto - valores menores trocam mais rápido, mas com
# menos garantia de detectar uma falha de inicialização.
ADSB_START_CONFIRM_SEC=1.2
RADIO_START_CONFIRM_SEC=0.8
